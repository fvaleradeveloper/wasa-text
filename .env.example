# AI Provider Configuration
# Choose one provider and configure the corresponding variables

# Option 1: Groq (IA Cloud Gratuita - Recommended)
AI_PROVIDER=groq
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Google Gemini
# AI_PROVIDER=google
# AI_API_KEY=your_gemini_api_key_here
# AI_MODEL=gemini-2.0-flash-exp

# Option 3: OpenAI
# AI_PROVIDER=openai
# AI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o-mini

# Option 4: Anthropic
# AI_PROVIDER=anthropic
# AI_API_KEY=your_anthropic_api_key_here
# AI_MODEL=claude-3-5-haiku-20241022

# Option 5: Custom OpenAI-compatible API
# AI_PROVIDER=openrouter
# AI_API_KEY=your_openrouter_api_key_here
# AI_MODEL=openrouter/free
# AI_BASE_URL=https://openrouter.ai/api/v1

# Legacy Gemini configuration (still supported)
# GEMINI_API_KEY=your_gemini_api_key_here

# Email Notification Configuration (SMTP)
# Used to send notifications to fvalera.developer@gmail.com when someone subscribes
# For Gmail, you need an App Password (not your regular password):
# 1. Enable 2FA in your Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password_here
#
# For other email providers, adjust SMTP_HOST and SMTP_PORT accordingly
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
